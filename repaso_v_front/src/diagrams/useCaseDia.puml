@startuml 

!pragma layout smetana
left to right direction
actor "Client" as Client

rectangle "Document download" {
    
    usecase "View Clients" as view
    usecase "Select Client" as select
    usecase "Add Client" as add
    usecase "Edit Client" as edit
    usecase "Delete Client" as delete

    Admin --> view 
    select ..>  view : <<extend>> 
    edit ..> select : <<include>>
    add ..> view : <<extend>>
    delete ..> select : <<include>>

}

@enduml